---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SectionLayout from "../../layouts/SectionLayout.astro";
import { sections, sectionOrder, type SectionId } from "../../sections";

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const paths = [];

  for (const id of sectionOrder) {
    const entries = await getCollection(id, ({ data }) =>
      isProd ? !data.draft : true
    );
    for (const entry of entries) {
      paths.push({
        params: { section: id, slug: entry.id },
        props: { sectionId: id, entry },
      });
    }
  }

  return paths;
}

type Props = {
  sectionId: SectionId;
  entry: CollectionEntry<SectionId>;
};

const { sectionId, entry } = Astro.props as Props;
const section = sections[sectionId];
const { Content } = await render(entry);

const dateFmt = new Intl.DateTimeFormat("it-IT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<SectionLayout
  section={section}
  pageTitle={entry.data.title}
  description={entry.data.description}
>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <div class="mb-10">
      <a
        href={`/${section.id}/`}
        class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors"
      >
        ← {section.label}
      </a>
    </div>

    <header class="mb-12 border-b border-neutral-200 pb-10">
      <div class="mb-4 flex flex-wrap gap-2">
        {
          entry.data.categories.map((c) => (
            <span class="text-xs uppercase tracking-wider" style="color: var(--accent);">
              {c}
            </span>
          ))
        }
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-semibold leading-tight tracking-tight text-neutral-900">
        {entry.data.title}
      </h1>
      <p class="mt-4 text-lg text-neutral-600">{entry.data.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-neutral-500">
        <time datetime={entry.data.date.toISOString()}>
          {dateFmt.format(entry.data.date)}
        </time>
        {
          entry.data.authors && entry.data.authors.length > 0 && (
            <span>{entry.data.authors.join(", ")}</span>
          )
        }
      </div>
    </header>

    <div class="prose-research font-serif text-lg leading-relaxed text-neutral-800">
      <Content />
    </div>
  </article>
</SectionLayout>

<style is:global>
  .prose-research h2 {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #171717;
  }
  .prose-research h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #171717;
  }
  .prose-research p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose-research a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose-research a:hover {
    opacity: 0.75;
  }
  .prose-research ul,
  .prose-research ol {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose-research ul {
    list-style: disc;
  }
  .prose-research ol {
    list-style: decimal;
  }
  .prose-research li {
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
  }
  .prose-research blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    color: #525252;
    font-style: italic;
  }
  .prose-research code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
    background-color: #f5f5f5;
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }
  .prose-research pre {
    background-color: #fafafa;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .prose-research pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .prose-research hr {
    border: none;
    border-top: 1px solid #e5e5e5;
    margin: 2.5rem 0;
  }
  .prose-research img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 1.5rem 0;
  }
  .prose-research strong {
    font-weight: 600;
    color: #171717;
  }
</style>
