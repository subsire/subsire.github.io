---
import HomeHero from "../layouts/HomeHero.astro";
import MerchSection from "../layouts/MerchSection.astro";
import Layout from "../layouts/Layout.astro";
import TiersSection from "../layouts/TiersSection.astro";
import TestimonialSection from "../layouts/TestimonialSection.astro";
import FaqSection from "../layouts/FaqSection.astro";
import Brand from "../components/Brand.astro";
---

<Layout
  title="Luca Farewell Fund"
  description="Sostieni la Migrazione Assistita"
  link="https://freedomflotilla.info/sostieni-freedom-flotilla-italia/"
>
  <Fragment slot="nav">
    <Brand animated={false} />
  </Fragment>
  <HomeHero />
  <MerchSection />
  <TiersSection link="https://freedomflotilla.info/sostieni-freedom-flotilla-italia/" />
  <div class="bg-mang bg-[url(/images/bg-hero-tiled.webp)] bg-center bg-fixed">
    <TestimonialSection />
    <FaqSection />
  </div>
</Layout>
